# ==============================================================================
# Citi Pharma Laboratory Information Management System (Star-LIMS)
# Environment Variables Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend & API Client Configuration (Exposed to Browser)
# ------------------------------------------------------------------------------
# Base URL for the LIMS API. Defaults to "/api" (internal Next.js Route Handlers).
# For external microservices, point to e.g. "https://api-lims.citipharma.com/v1"
NEXT_PUBLIC_API_URL=/api

# Toggle mock services vs real backend API.
# "true" (default) = uses in-memory mock datasets conforming to pharmacopeial monographs.
# "false" = delegates all service operations to REST endpoints via ApiClient.
NEXT_PUBLIC_USE_MOCK=true

# HTTP network timeout in milliseconds (default: 15000 = 15 seconds)
NEXT_PUBLIC_API_TIMEOUT_MS=15000

# ------------------------------------------------------------------------------
# 2. Future Backend & Database Connection (Server-Only, Never Exposed to Browser)
# ------------------------------------------------------------------------------
# MySQL Database Connection String (used by Prisma ORM or mysql2/promise connection pool)
DATABASE_URL=mysql://citipharma_user:StrongPassword123!@localhost:3306/citipharma_lims?schema=public&sslmode=prefer

# Individual MySQL connection parameters (alternative to single DATABASE_URL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=citipharma_lims
MYSQL_USER=citipharma_user
MYSQL_PASSWORD=StrongPassword123!
MYSQL_CONNECTION_LIMIT=20

# ------------------------------------------------------------------------------
# 3. 21 CFR Part 11 & Security Configuration (Server-Only)
# ------------------------------------------------------------------------------
# JWT secret for analyst & QA electronic signatures and session tokens
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRY=8h

# Audit trail tamper-evident HMAC signing key
AUDIT_TRAIL_HMAC_SECRET=lims-audit-secret-hmac-sha256-key-citipharma
